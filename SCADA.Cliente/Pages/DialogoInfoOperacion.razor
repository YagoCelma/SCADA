@using SCADA.Modelos
@using Radzen
@using Radzen.Blazor

@inject DialogService DialogService
@inject SCADA.Cliente.Services.ImputacionService ImputacionService

<RadzenStack Gap="1rem">
    <RadzenRow>
        <RadzenColumn Size="6">
            <RadzenText TextStyle="TextStyle.Subtitle2" class="rz-color-base-500">Orden</RadzenText>
            <RadzenText TextStyle="TextStyle.Body1">@OperacionInfo.NombreOrden</RadzenText>
        </RadzenColumn>
        @* <RadzenColumn Size="6">
            <RadzenText TextStyle="TextStyle.Subtitle2" class="rz-color-base-500">Máquina</RadzenText>
            <RadzenText TextStyle="TextStyle.Body1">@OperacionInfo.NombreMaquina</RadzenText>
        </RadzenColumn> *@
    </RadzenRow>

    <RadzenRow>
        <RadzenColumn Size="12">
            <RadzenText TextStyle="TextStyle.Subtitle2" class="rz-color-base-500">Producto</RadzenText>
            <RadzenText TextStyle="TextStyle.Body1">@OperacionInfo.Producto</RadzenText>
        </RadzenColumn>
    </RadzenRow>

    @* <RadzenRow>
        <RadzenColumn Size="4">
            <RadzenText TextStyle="TextStyle.Subtitle2" class="rz-color-base-500">Objetivo</RadzenText>
            <RadzenText TextStyle="TextStyle.Body1">@OperacionInfo.CiclosObjetivo</RadzenText>
        </RadzenColumn>
        <RadzenColumn Size="4">
            <RadzenText TextStyle="TextStyle.Subtitle2" class="rz-color-base-500">Fabricadas</RadzenText>
            <RadzenText TextStyle="TextStyle.Body1">@OperacionInfo.PiezasFabricadas</RadzenText>
        </RadzenColumn>
        <RadzenColumn Size="4">
            <RadzenText TextStyle="TextStyle.Subtitle2" class="rz-color-base-500">Rotas</RadzenText>
            <RadzenText TextStyle="TextStyle.Body1">@OperacionInfo.PiezasRotas</RadzenText>
        </RadzenColumn>
    </RadzenRow> *@

    <hr style="border: 0; border-top: 1px solid #ccc; margin: 10px 0;" />

    @* tabla de horas operario *@
    <RadzenText TextStyle="TextStyle.Subtitle2" class="rz-color-base-500">Horas imputadas por operario</RadzenText>

    @if (listaOperarios == null)
    {
        <RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
    }
    else if (!listaOperarios.Any())
    {
        @* si la lista esta vacia *@
        <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Text" ShowIcon="false" class="rz-p-2 rz-m-0">
            Nadie ha imputado horas en esta operación todavía.
        </RadzenAlert>
    }
    else
    {
        <RadzenTabs class="rz-mt-2" Style="--rz-tabs-tab-font-size: 0.85rem;">
            <Tabs>
                @* Pestaña Horas Operarios *@
                <RadzenTabsItem Text="Horas Operarios" Icon="schedule">
                    @if (listaOperarios == null)
                    {
                        <RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" class="rz-mt-2" />
                    }
                    else if (!listaOperarios.Any())
                    {
                        <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Text" class="rz-p-2 rz-mt-2" Size="AlertSize.Small">
                            Sin horas imputadas.
                        </RadzenAlert>
                    }
                    else
                    {
                        <RadzenDataGrid Data="@listaOperarios" TItem="OperarioHorasDTO" Density="Density.Compact" class="rz-mt-2">
                            <Columns>
                                <RadzenDataGridColumn TItem="OperarioHorasDTO" Property="CodigoOperario" Title="Cód." Width="120px">
                                    <Template Context="op">
                                        <span style="font-size: 0.85rem; color: #64748B;">@op.CodigoOperario</span>
                                    </Template>
                                </RadzenDataGridColumn>
                        
                                <RadzenDataGridColumn TItem="OperarioHorasDTO" Property="NombreCompleto" Title="Nombre">
                                    <Template Context="op">
                                        <span style="font-weight: 600; font-size: 0.85rem; color: #1A2E3F;">@op.NombreCompleto</span>
                                    </Template>
                                </RadzenDataGridColumn>

                                <RadzenDataGridColumn TItem="OperarioHorasDTO" Property="TotalHoras" Title="Tiempo" Width="100px" TextAlign="TextAlign.Center">
                                    <Template Context="op">
                                        <span style="font-weight: 700; color: #1F4E79; font-size: 0.85rem;">
                                            @{
                                                var tr = TimeSpan.FromHours((double)op.TotalHoras);
                                            }
                                            @((int)tr.TotalHours)h @tr.Minutes.ToString("D2")m
                                        </span>
                                    </Template>
                                </RadzenDataGridColumn>
                            </Columns>
                        </RadzenDataGrid>
                    }
                </RadzenTabsItem>

                @* Pestaña Materiales *@
                <RadzenTabsItem Text="Materiales" Icon="inventory_2">
                    @if (listaMateriales == null)
                    {
                        <RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" class="rz-mt-2" />
                    }
                    else if (!listaMateriales.Any())
                    {
                        <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Text" class="rz-p-2 rz-mt-2" Size="AlertSize.Small">
                            Sin consumos registrados.
                        </RadzenAlert>
                    }
                    else
                    {
                        <RadzenDataGrid Data="@listaMateriales" TItem="ImputacionMaterial" Density="Density.Compact" class="rz-mt-2" AllowPaging="true" PageSize="5">
                            <Columns>
                                <RadzenDataGridColumn TItem="ImputacionMaterial" Title="Material">
                                    <Template Context="mat">
                                        <div style="display: flex; align-items: center; gap: 4px;">
                                            <span style="font-weight: 600; font-size: 0.85rem; color: #1A2E3F;">@(mat.Material?.Nombre ?? "---")</span>
                                            @if (mat.EsMerma)
                                            {
                                                <span style="background-color: #EF4444; color: white; font-size: 0.65rem; padding: 1px 4px; border-radius: 3px; font-weight: bold;">MERMA</span>
                                            }
                                        </div>
                                    </Template>
                                </RadzenDataGridColumn>
                        
                                <RadzenDataGridColumn TItem="ImputacionMaterial" Property="Cantidad" Title="Cant." Width="70px" TextAlign="TextAlign.Center">
                                    <Template Context="mat">
                                        <span style="font-weight: 800; font-size: 0.85rem; color: #1F4E79;">@mat.Cantidad</span>
                                    </Template>
                                </RadzenDataGridColumn>

                                <RadzenDataGridColumn TItem="ImputacionMaterial" Title="Operario">
                                    <Template Context="mat">
                                        <div style="font-size: 0.8rem; color: #64748B; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                            <span style="font-weight: bold;">[@(mat.Empleado?.CodigoEmpleado ?? "---")]</span> @mat.Empleado?.Nombre @mat.Empleado?.Apellidos
                                        </div>
                                    </Template>
                                </RadzenDataGridColumn>

                                <RadzenDataGridColumn TItem="ImputacionMaterial" Property="FechaRegistro" Title="Fecha" Width="100px">
                                    <Template Context="mat">
                                        <span style="font-size: 0.8rem; color: #94A3B8;">@mat.FechaRegistro.ToString("dd/MM HH:mm")</span>
                                    </Template>
                                </RadzenDataGridColumn>
                            </Columns>
                        </RadzenDataGrid>
                    }
                </RadzenTabsItem>
            </Tabs>
        </RadzenTabs>
    }

    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" class="rz-mt-4">
        <RadzenButton Text="Cerrar" Click="() => DialogService.Close()" ButtonStyle="ButtonStyle.Light" />
    </RadzenStack>
</RadzenStack>

@code {
    [Parameter] public OperacionResumenDTO OperacionInfo { get; set; }

    private List<OperarioHorasDTO> listaOperarios;
    private List<ImputacionMaterial> listaMateriales;

    protected override async Task OnInitializedAsync()
    {

        listaOperarios = await ImputacionService.ObtenerHorasPorOperarioAsync(OperacionInfo.Id);
        listaMateriales = await ImputacionService.ObtenerImputacionMaterialesAsync(OperacionInfo.Id);
    }
}