@page "/fichajes-tablet"
@inject NotificationService NotificationService
@inject NavigationManager NavManager

<RadzenCard Style="max-width: 500px; margin: 2rem auto; border-radius: 20px;">
    @if (!estaAutenticado)
    {
        @* teclado *@
        <div style="margin-bottom: 2rem; text-align: center;">
            <RadzenText TextStyle="TextStyle.H5" TagName="TagName.H1" Style="margin: 0;">
                <b>Introduce tu PIN</b>
            </RadzenText>
        </div>

        <div class="numpad-container">
            <div class="pin-display">@(new String('•', pinIngresado.Length))</div>
            <div class="numpad-grid">
                @for (int i = 1; i <= 9; i++)
                {
                    int n = i;
                    <button class="num-btn" @onclick="() => AgregarNumero(n)">@n</button>
                }
                <button class="num-btn btn-clear" @onclick="BorrarNumero"><RadzenIcon Icon="backspace" /></button>
                <button class="num-btn" @onclick="() => AgregarNumero(0)">0</button>
                <button class="num-btn btn-enter" @onclick="ValidarPin"><RadzenIcon Icon="login" /></button>
            </div>
        </div>
    }
    else
    {
        @* opciones de fichaje *@
        <RadzenStack AlignItems="AlignItems.Center" Gap="1.5rem" class="rz-p-4">
            <RadzenText TextStyle="TextStyle.H4">Hola, <b>@nombreOperario</b></RadzenText>

            @* Cuadro de información de hora y motivo *@
            @if (!string.IsNullOrEmpty(horaFichaje))
            {
                <RadzenAlert Severity="AlertSeverity.Info" Variant="Variant.Flat" AllowClose="false" Style="width: 100%; text-align: center;">
                    Último estado a las <b>@horaFichaje</b>
                    @if (!string.IsNullOrEmpty(motivoSeleccionado))
                    {
                        <span> - Motivo: <b>@motivoSeleccionado</b></span>
                    }
                </RadzenAlert>
            }
            
            @if (mostrandoMotivosPausa)
            {
                @* motivos de la pausa *@
                <RadzenText TextStyle="TextStyle.Subtitle1">¿Cuál es el motivo de la pausa?</RadzenText>
                <RadzenRow class="w-100" Gap="1rem">
                    @* cafe *@
                    <RadzenColumn Size="6">
                        <RadzenButton Text="CAFÉ" Icon="local_cafe"
                                      ButtonStyle="ButtonStyle.Primary"
                                      class="w-100" Style="height: 100px; font-size: 1.2rem;"
                                      Click="@(() => ConfirmarPausa("Café"))" />
                    </RadzenColumn>
                    @* baño *@
                    <RadzenColumn Size="6">
                        <RadzenButton Text="BAÑO" Icon="wc"
                                      ButtonStyle="ButtonStyle.Info"
                                      class="w-100" Style="height: 100px; font-size: 1.2rem;"
                                      Click="@(() => ConfirmarPausa("Baño"))" />
                    </RadzenColumn>
                    @* conciliacion *@
                    <RadzenColumn Size="12">
                        <RadzenButton Text="CONCILIACIÓN" Icon="home"
                                      ButtonStyle="ButtonStyle.Warning" class="w-100"
                                      Style="height: 100px; font-size: 1.2rem;"
                                      Click="@(() => ConfirmarPausa("Conciliacion"))" />

                    </RadzenColumn>
                </RadzenRow>

                <RadzenButton Text="Cancelar" Variant="Variant.Text"
                              Click="CancelarPausa" class="rz-mt-2" />
            }
            else if (mostrandoMotivosAusencia)
            {
                <RadzenText TextStyle="TextStyle.Subtitle1">¿Cual es el motivo de la ausencia?</RadzenText>
                <RadzenRow class="w-100" Gap="1rep">

                    @* medico de cabecera *@
                    <RadzenColumn Size="12">
                        <RadzenButton Text="MÉDICO DE CABECERA" Icon="medical_services"
                                      ButtonStyle="ButtonStyle.Primary"
                                      class="w-100" Style="height: 100px; font-size: 1.2rem;"
                                      Click="@(() => ConfirmarAusencia("Médico cabecera"))" />
                    </RadzenColumn>
                    @* medico especialista *@
                    <RadzenColumn Size="12">
                        <RadzenButton Text="MÉDICO ESPECIALISTA" Icon="medical_services"
                                      ButtonStyle="ButtonStyle.Warning"
                                      class="w-100" Style="height: 100px; font-size: 1.2rem;"
                                      Click="@(() => ConfirmarAusencia("Médico especialista"))" />
                    </RadzenColumn>
                </RadzenRow>

                <RadzenButton Text="Cancelar" Variant="Variant.Text"
                              Click="CancelarAusencia" class="rz-mt-2" />
            }
            else
            {
                @* pantalla principal *@

                @* botón trabajando *@
                <RadzenButton Text="@(estadoActual == "Fuera" ? "INICIAR JORNADA" : (estadoActual == "Trabajando" ? "TRABAJANDO..." : "REANUDAR TRABAJO"))"
                              Icon="play_circle"
                              ButtonStyle="ButtonStyle.Success"
                              Size="ButtonSize.Large"
                              class="w-100" Style="height: 100px; font-size: 1.5rem;"
                              Disabled="@(estadoActual == "Trabajando")"
                              Click="IniciarTrabajo" />

                @* botón pausa *@
                <RadzenRow class="w-100" Gap="1rem">
                    <RadzenColumn Size="6">
                        <RadzenButton Text="PAUSA" Icon="pause_circle"
                                      ButtonStyle="ButtonStyle.Warning"
                                      class="w-100" Style="height: 80px;"
                                      Disabled="@(estadoActual != "Trabajando")"
                                      Click="PedirMotivoPausa" />
                    </RadzenColumn>

                    @* botón ausencia *@
                    <RadzenColumn Size="6">
                        <RadzenButton Text="AUSENCIA" Icon="event_busy"
                                      ButtonStyle="ButtonStyle.Danger"
                                      class="w-100" Style="height: 80px;"
                                      Disabled="@(estadoActual != "Trabajando")"
                                      Click="PedirMotivoAusencia" />
                    </RadzenColumn>
                </RadzenRow>

                @if (estadoActual != "Fuera")
                {
                    <RadzenButton Text="FINALIZAR DÍA" Icon="stop_circle"
                                  ButtonStyle="ButtonStyle.Secondary"
                                  class="rz-mt-4 w-100" Click="FinalizarDia" />
                }

                <RadzenButton Text="Salir / Cambiar Usuario" Variant="Variant.Text"
                              Click="Logout" class="rz-mt-2" />
            }
        </RadzenStack>
    }
</RadzenCard>

<style>
    .numpad-container { max-width: 350px; margin: 2rem auto 0 auto; }
    .pin-display {
        background: white; border: 2px solid #D5E3EF; border-radius: 12px;
        font-size: 3rem; letter-spacing: 15px; text-align: center;
        height: 80px; line-height: 80px; margin-bottom: 20px;
        color: #1F4E79; overflow: hidden;
    }
    .numpad-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 15px; }
    .num-btn {
        background: white; border: 2px solid #D5E3EF; border-radius: 12px;
        font-size: 2rem; font-weight: bold; color: #1F4E79;
        padding: 20px 0; cursor: pointer; transition: all 0.1s;
        display: flex; align-items: center; justify-content: center;
    }
    .num-btn:active { background: #E9EEF4; transform: scale(0.95); }
    .btn-clear { background:#dc3545; color: white; border-color: #dc3545 }
    .btn-enter { background: #28a745; color: white; border-color: #28a745; }
    .btn-enter:active { background: #218838; }
    .w-100 { width: 100%; }
</style>

@code {
    private string pinIngresado = "";
    private bool estaAutenticado = false;
    private string nombreOperario = "";

    private string estadoActual = "Fuera";
    private string? horaFichaje;
    private string? motivoSeleccionado;
    private bool mostrandoMotivosPausa = false;
    private bool mostrandoMotivosAusencia = false;

    private void AgregarNumero(int numero) { if (pinIngresado.Length < 10) pinIngresado += numero.ToString(); }
    private void BorrarNumero() { if (pinIngresado.Length > 0) pinIngresado = pinIngresado.Substring(0, pinIngresado.Length - 1); }

    private void ValidarPin()
    {
        if (pinIngresado == "1234")
        {
            estaAutenticado = true;
            nombreOperario = "Operario Test";
            pinIngresado = "";
            estadoActual = "Fuera";
            horaFichaje = null;
            motivoSeleccionado = null;
        }
        else
        {
            NotificationService.Notify(NotificationSeverity.Error, "Error", "PIN incorrecto");
            pinIngresado = "";
        }
    }

    private void IniciarTrabajo()
    {
        estadoActual = "Trabajando";
        motivoSeleccionado = null;
        horaFichaje = DateTime.Now.ToString("HH:mm");
    }


    private void PedirMotivoPausa()
    {
        mostrandoMotivosPausa = true;
    }

    private void ConfirmarPausa(string motivo)
    {
        estadoActual = "Pausa";
        motivoSeleccionado = motivo;
        horaFichaje = DateTime.Now.ToString("HH:mm");
        mostrandoMotivosPausa = false;
    }

    private void CancelarPausa()
    {
        mostrandoMotivosPausa = false;
    }

    private void IniciarAusencia()
    {
        estadoActual = "Ausencia";
        motivoSeleccionado = null;
        horaFichaje = DateTime.Now.ToString("HH:mm");
    }

    private void FinalizarDia()
    {
        estadoActual = "Fuera";
        Logout();
    }

    private void Logout()
    {
        estaAutenticado = false;
        estadoActual = "Fuera";
        mostrandoMotivosPausa = false;
    }

    public void ConfirmarAusencia(string motivo)
    {
        estadoActual = "Ausencia";
        motivoSeleccionado = motivo;
        horaFichaje = DateTime.Now.ToString("HH:mm");
        mostrandoMotivosAusencia = false;
    }

    private void PedirMotivoAusencia()
    {
        mostrandoMotivosAusencia = true;
    }

    public void CancelarAusencia()
    {
        mostrandoMotivosAusencia = false;
    }
}